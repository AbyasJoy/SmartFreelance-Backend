# SmartFreelance Backend Environment Variables Template
DB_URL=jdbc:mysql://localhost:3306/smartfreelance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

JWT_SECRET=YOUR_SECURE_32_CHARACTER_LONG_JWT_SECRET_KEY_HERE
JWT_EXPIRATION=86400000

# Gemini AI Assistant API Key Configuration (Optional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
